// Schnorr Signature Verification Polyfill for the Jubjub curve.
// Adapted from Midnight Foundation's example-zkloan (Apache-2.0):
// https://github.com/midnightntwrk/example-zkloan/blob/main/contract/src/schnorr.compact
// The proof exposes the reduced challenge, but keeps the announcement, response,
// signed attributes, and holder secret private. The issuer public key is public
// ledger state by design.
pragma language_version >= 0.22 && <= 0.23;

module schnorr {
  import CompactStandardLibrary;

  export struct SchnorrSignature {
    announcement: JubjubPoint;
    response: Field;
  }

  struct SchnorrHashInput<#n> {
    ann_x: Field;
    ann_y: Field;
    pk_x: Field;
    pk_y: Field;
    msg: Vector<n, Field>;
  }

  witness getSchnorrReduction(challengeHash: Field): [Uint<7>, Uint<248>];

  export circuit schnorrVerify<#n>(
    msg: Vector<n, Field>,
    signature: SchnorrSignature,
    pk: JubjubPoint
  ): [] {
    const {announcement, response} = signature;
    assert(announcement != default<JubjubPoint>, "Invalid issuer signature announcement");
    assert(pk != default<JubjubPoint>, "Invalid issuer public key");
    const cFull: Field = transientHash<SchnorrHashInput<n>>(
      SchnorrHashInput<n> {
        ann_x: jubjubPointX(announcement),
        ann_y: jubjubPointY(announcement),
        pk_x: jubjubPointX(pk),
        pk_y: jubjubPointY(pk),
        msg: msg
      }
    );
    const TWO_248: Field =
      452312848583266388373324160190187140051835877600158453279131187530910662656 as Field;
    const [q, cTruncated] = getSchnorrReduction(cFull);
    assert(disclose(q) < 116, "Schnorr quotient out of range");
    assert(
      disclose(q) * TWO_248 + (disclose(cTruncated) as Field) == cFull,
      "Invalid challenge reduction"
    );
    const c: Field = disclose(cTruncated) as Field;
    const lhs: JubjubPoint = ecMulGenerator(response);
    const rhs: JubjubPoint = ecAdd(announcement, ecMul(pk, c));
    assert(
      jubjubPointX(lhs) == jubjubPointX(rhs) && jubjubPointY(lhs) == jubjubPointY(rhs),
      "Invalid issuer signature"
    );
  }

  export pure circuit schnorrChallenge<#n>(
    ann_x: Field,
    ann_y: Field,
    pk_x: Field,
    pk_y: Field,
    msg: Vector<n, Field>
  ): Field {
    return transientHash<SchnorrHashInput<n>>(
      SchnorrHashInput<n> {
        ann_x: ann_x,
        ann_y: ann_y,
        pk_x: pk_x,
        pk_y: pk_y,
        msg: msg
      }
    );
  }
}
