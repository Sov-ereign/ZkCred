pragma language_version 0.23.0;
import CompactStandardLibrary;

// =============================================================================
// ZkCred (AegisID) — Multi-Attribute Age & Financial Eligibility Gate
// Language: Compact v0.23 | Target: Midnight Network Preprod
// Level 3 Track: Option 2 — Age / Eligibility Gate
// =============================================================================
//
// PRIVACY MODEL:
// ┌───────────────────────────┐      ┌────────────────────────────────────┐
// │   PRIVATE WITNESS (LOCAL) │ ──── │  SELECTIVE DISCLOSURE              │
// │   - age                   │      │  disclose(saltNullifier)           │
// │   - creditScore           │      │  disclose(eligible)                │
// │   - annualIncome          │      │         ↓                          │
// │   - userSalt              │      │  PUBLIC LEDGER STATE               │
// │   - issuerKey             │      │  - usedSaltNullifiers (Set)        │
// │   - credentialToken       │      │  - eligibleNullifiers (Set)        │
// └───────────────────────────┘      │  - isEligible (last call, for UX)  │
//                                    │  - admin (hash of admin key)       │
//                                    │  - issuerKeyHash                   │
//                                    │  - initialized (one-time guard)    │
//                                    └────────────────────────────────────┘
//
// ADMIN KEY SECURITY:
//   The admin field stores persistentHash([adminKey]), NOT the raw key.
//   This means the admin key can never be recovered from on-chain state.
//   The updateThresholds circuit hashes the private witness and compares
//   against the committed hash.
//
// INITIALIZATION GUARD:
//   initialize() can only be called ONCE. The `initialized` boolean ledger
//   field is false at deployment (Compact default) and is set to true
//   by initialize(). Any subsequent call asserts on !initialized and reverts.
//
// ISSUER CREDENTIAL AUTHENTICATION:
//   Credential values (age, creditScore, annualIncome) must be attested by a
//   registered trusted issuer before they can be proven in a ZK circuit.
//   The issuer model uses a hash-based commitment scheme (the maximum
//   expressible with Compact's persistentHash primitive; full BLS/ECDSA
//   signature verification over structured data requires signature primitives
//   not yet in the Compact standard library):
//
//   1. Admin registers issuerKeyHash = persistentHash([issuerSecret]) on-chain.
//   2. Issuer authenticates the user (KYC, credit bureau, OAuth).
//   3. Issuer generates:
//        credentialToken = persistentHash([issuerSecret, userSalt])
//      and delivers it to the user out-of-band.
//   4. In verifyEligibility, the circuit:
//      a. Receives issuerKey as a private witness (provided by the issuer).
//      b. Asserts persistentHash([issuerKey]) == issuerKeyHash (registered issuer).
//      c. Asserts persistentHash([issuerKey, salt]) == credentialToken (issuer
//         attested to this specific call/salt — user was authenticated).
//   5. Without the issuer's secret, a user cannot self-forge a valid
//      credentialToken even if they know the issuerKeyHash on-chain.
//
// NULLIFIER SEMANTICS:
//   usedSaltNullifiers — records every salt that has been used (replay guard).
//   eligibleNullifiers — records only the salts whose call resulted in eligible=true.
//   A relying party MUST check eligibleNullifiers.member(nullifier), NOT the
//   global isEligible flag. isEligible reflects the LAST call only and is
//   provided solely for lightweight UI display.
//   Salt nullifiers prevent replay of the same salt commitment; a fresh salt
//   always permits a new call. They do NOT prove credential authenticity.
// =============================================================================

// --- Public Ledger State (on-chain visible) ---
export ledger minCreditScore: Uint<32>;
export ledger minAnnualIncome: Uint<64>;
export ledger minAge: Uint<32>;
// isEligible: reflects the most recent verifyEligibility call only.
// RELYING PARTIES: use eligibleNullifiers.member(nullifier) instead.
export ledger isEligible: Boolean;
export ledger verificationCount: Uint<64>;
// admin stores persistentHash<Vector<1, Bytes<32>>>([rawAdminKey]).
// The raw admin key is NEVER written to the ledger.
export ledger admin: Bytes<32>;
// usedSaltNullifiers: every salt nullifier ever submitted (replay prevention).
// Prevents the same salt from being re-used; a fresh salt permits a new call.
export ledger usedSaltNullifiers: Set<Bytes<32>>;
// eligibleNullifiers: nullifiers whose verifyEligibility call returned true.
// Relying parties query this set to verify a specific user's eligibility
// without depending on the mutable global isEligible flag.
export ledger eligibleNullifiers: Set<Bytes<32>>;
// issuerKeyHash: persistentHash([issuerSecret]) registered by the admin.
// verifyEligibility asserts that credentials were attested by this issuer.
// The raw issuer secret is never stored on-chain.
export ledger issuerKeyHash: Bytes<32>;
// initialized: one-time guard. False at deployment (Compact default = false).
// Set to true by initialize(). Prevents re-initialization attacks.
export ledger initialized: Boolean;

// --- Private Witness Declarations (local off-chain only) ---
witness getPrivateCreditScore(): Uint<32>;
witness getPrivateAnnualIncome(): Uint<64>;
witness getPrivateAge(): Uint<32>;
witness getPrivateSalt(): Bytes<32>;
witness getPrivateAdminKey(): Bytes<32>;
// getPrivateIssuerKey: the trusted issuer's secret key. The issuer delivers
// this to the user AFTER authenticating their real credentials (KYC / credit
// bureau / OAuth). Users cannot self-generate a valid issuer key.
witness getPrivateIssuerKey(): Bytes<32>;
// getPrivateCredentialToken: persistentHash([issuerKey, userSalt]) computed by
// the issuer and delivered out-of-band. Binding the token to the salt prevents
// a token from one session being replayed in another.
witness getPrivateCredentialToken(): Bytes<32>;

// --- Constructor / Initializer ---
// ONE-TIME ONLY: asserts !initialized. Reverts if called a second time.
// adminAddress: the raw 32-byte admin key — only its hash is stored.
// issuerKeyHashParam: admin provides persistentHash([issuerSecret]) to
//   register the trusted credential issuer for this contract instance.
export circuit initialize(
  creditScoreThreshold: Uint<32>,
  annualIncomeThreshold: Uint<64>,
  ageThreshold: Uint<32>,
  adminAddress: Bytes<32>,
  issuerKeyHashParam: Bytes<32>
): [] {
  // ONE-TIME GUARD: revert if already initialized.
  assert(!initialized, "ZkCred: Contract already initialized");
  initialized = disclose(true);

  minCreditScore = disclose(creditScoreThreshold);
  minAnnualIncome = disclose(annualIncomeThreshold);
  minAge = disclose(ageThreshold);
  isEligible = disclose(false);
  verificationCount = disclose(0 as Uint<64>);
  // Store ONLY the hash of the admin key. The raw key never touches the ledger.
  admin = disclose(persistentHash<Vector<1, Bytes<32>>>([adminAddress]));
  // Store the issuer key hash. Raw issuer secret is never stored on-chain.
  issuerKeyHash = disclose(issuerKeyHashParam);
}

// --- Option 2 Core ZK Eligibility Gate Circuit ---
// Evaluates Age, Credit Score, and Income inside PLONK ZK Circuit.
// Discloses ONLY the boolean outcome and the salt nullifier. Raw credential
// values (age, score, income) are never disclosed.
// ISSUER AUTHENTICATION: verifies credentials were attested by the registered
// trusted issuer before any threshold check is performed.
export circuit verifyEligibility(): [] {
  // Retrieve private values from off-chain witnesses
  const creditScore: Uint<32> = getPrivateCreditScore();
  const annualIncome: Uint<64> = getPrivateAnnualIncome();
  const age: Uint<32> = getPrivateAge();
  const salt: Bytes<32> = getPrivateSalt();

  // --- ISSUER CREDENTIAL AUTHENTICATION ---
  // Retrieve the issuer's secret and the credential token it generated.
  // The issuer delivers these to the user after authenticating their real
  // credentials (KYC, credit bureau, OAuth). Users cannot self-forge tokens.
  const issuerKey: Bytes<32> = getPrivateIssuerKey();
  const credentialToken: Bytes<32> = getPrivateCredentialToken();

  // (1) Verify this is the registered trusted issuer.
  const computedIssuerHash: Bytes<32> = persistentHash<Vector<1, Bytes<32>>>([issuerKey]);
  assert(computedIssuerHash == issuerKeyHash,
    "Credential not attested by registered trusted issuer");

  // (2) Verify the credential token binds this issuer key to this specific
  //     salt — the issuer authenticated the user for this particular call.
  //     Without the issuer's secret, a user cannot forge a matching token.
  const expectedToken: Bytes<32> = persistentHash<Vector<2, Bytes<32>>>([
    issuerKey,
    salt
  ]);
  assert(expectedToken == credentialToken,
    "Credential token does not match issuer attestation for this salt");

  // Compute a domain-separated nullifier from the private salt.
  // NULLIFIER SEMANTICS: prevents replay of THIS specific salt commitment.
  // A fresh salt always permits a new call. This does NOT prove credential
  // authenticity — only that this particular salt has not been used before.
  const saltNullifier: Bytes<32> = disclose(persistentHash<Vector<2, Bytes<32>>>([ 
    pad(32, "zkcred:eligibility:nullifier:v1"),
    salt
  ]));
  assert(!usedSaltNullifiers.member(saltNullifier), "Credential salt already used");

  // Evaluate thresholds inside ZK circuit (zero-knowledge proof)
  const meetsScoreThreshold: Boolean = creditScore >= minCreditScore;
  const meetsIncomeThreshold: Boolean = annualIncome >= minAnnualIncome;
  const meetsAgeThreshold: Boolean = age >= minAge;

  const eligible: Boolean = meetsScoreThreshold && meetsIncomeThreshold && meetsAgeThreshold;

  // Record this call's nullifier in usedSaltNullifiers (always — replay guard)
  usedSaltNullifiers.insert(disclose(saltNullifier));

  // Record in eligibleNullifiers ONLY when eligible.
  // Relying parties: check eligibleNullifiers.member(yourNullifier).
  if eligible {
    eligibleNullifiers.insert(disclose(saltNullifier));
  }

  // Update global flag (last-writer-wins — for UI display only).
  isEligible = disclose(eligible);

  // Increment public verification counter with explicit Uint<64> cast
  const newCount: Uint<64> = (verificationCount + (1 as Uint<64>)) as Uint<64>;
  verificationCount = disclose(newCount);
}

// --- Admin Circuit: Update Thresholds ---
// Requires the caller to supply the raw admin key as a private witness.
// The circuit hashes it and compares against the on-chain commitment.
// The raw admin key is never disclosed; only its hash is on the ledger.
export circuit updateThresholds(
  newMinCreditScore: Uint<32>,
  newMinAnnualIncome: Uint<64>,
  newMinAge: Uint<32>
): [] {
  // Authorize caller: hash the private witness and compare to stored commitment.
  const callerKey: Bytes<32> = getPrivateAdminKey();
  const callerHash: Bytes<32> = persistentHash<Vector<1, Bytes<32>>>([callerKey]);
  assert(callerHash == admin, "Unauthorized: caller is not authorized admin");

  minCreditScore = disclose(newMinCreditScore);
  minAnnualIncome = disclose(newMinAnnualIncome);
  minAge = disclose(newMinAge);
  isEligible = disclose(false);
}

// --- Relying-Party Query Circuits ---

// getEligibilityStatus: returns the global flag (last call only, for UI).
// RELYING PARTIES: use checkNullifierEligible instead.
export circuit getEligibilityStatus(): Boolean {
  return disclose(isEligible);
}

// checkNullifierEligible: authoritative per-call eligibility check.
// Pass the salt nullifier (persistentHash of domain-prefix + salt) to verify
// whether a specific verifyEligibility call resulted in eligible = true.
// This is the correct API for relying parties — it does not depend on the
// mutable global isEligible flag.
export circuit checkNullifierEligible(nullifier: Bytes<32>): Boolean {
  return disclose(eligibleNullifiers.member(nullifier));
}
