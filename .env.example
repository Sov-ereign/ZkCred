# ─── ZkCred (AegisID) Environment Variables ─────────────────────────────────
# Copy to .env for local development.
# On Render (API only), set these in: Dashboard → zkcred-api → Environment

# ─── Auth & JWT ────────────────────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# ─── MongoDB Atlas ─────────────────────────────────────────────────────────────
# Get a free cluster at https://www.mongodb.com/atlas
# Required. The API never falls back to in-memory users or verification data.
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/zkcred

# ─── Google OAuth 2.0 ────────────────────────────────────────────────────────
# 1. Go to https://console.cloud.google.com/apis/credentials
# 2. Create an OAuth 2.0 Client ID (Application type: Web application)
# 3. Add Authorized Redirect URI:
#      https://zkcred-api.onrender.com/api/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=https://zkcred-api.onrender.com/api/auth/google/callback

# ─── Server Port ────────────────────────────────────────────────────────────────
PORT=10000

# ─── Midnight Network ───────────────────────────────────────────────────────────
# Verified Compact contract address on Midnight Preprod (testnet-02).
# Leave blank until you deploy through the connected Lace wallet, then set the
# emitted address here and in your Vercel/Render environment variables.
CONTRACT_ADDRESS=

# Midnight Preprod Indexer GraphQL endpoint
MIDNIGHT_INDEXER_URL=https://indexer.preprod.midnight.network/api/v3/graphql

# ─── Proof Server (LOCAL ONLY) ──────────────────────────────────────────────────
# The Midnight proof server runs locally via Docker.
# Start it with: docker compose up -d
# It listens at http://localhost:6300
# DO NOT host this on Render — it uses Midnight's binary wire protocol, not REST.
# PROOF_SERVER_URL=http://localhost:6300   ← this is the default, no need to set
