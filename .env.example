# ─── ZkCred (AegisID) Environment Variables ─────────────────────────────────
# Copy this file to .env for local development.
# On Render, set these in: Dashboard → Service → Environment

# ─── Auth & JWT ────────────────────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# ─── MongoDB Atlas ─────────────────────────────────────────────────────────────
# Get a free cluster at https://www.mongodb.com/atlas
# Leave empty to use in-memory fallback (data resets on restart)
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/zkcred

# ─── Google OAuth 2.0 ────────────────────────────────────────────────────────
# 1. Go to https://console.cloud.google.com/apis/credentials
# 2. Create an OAuth 2.0 Client ID (Application type: Web application)
# 3. Add Authorized Redirect URI:
#      https://zkcred-api.onrender.com/api/auth/google/callback
# 4. Copy Client ID and Secret below
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=https://zkcred-api.onrender.com/api/auth/google/callback

# ─── Server Port ────────────────────────────────────────────────────────────────
PORT=10000

# ─── Midnight Network ───────────────────────────────────────────────────────────
# Deployed Compact contract address on Midnight Preprod (testnet-02)
CONTRACT_ADDRESS=0x0225677b7557435054732329333e104b4a0c5ce8e5fdd9d3cdcbdfc997a8bdab

# Midnight Preprod Indexer GraphQL endpoint (v3)
MIDNIGHT_INDEXER_URL=https://indexer.preprod.midnight.network/api/v3/graphql

# Midnight Proof Server — deploy via Render Docker service (see proof-server/Dockerfile)
# Set this to your Render proof server URL after deploying the second Render service
PROOF_SERVER_URL=https://zkcred-proof-server.onrender.com
