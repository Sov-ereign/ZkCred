# ─── ZkCred (AegisID) Environment Variables ─────────────────────────────────
# Copy this file to .env for local dev with `vercel dev`.
# On Vercel production, set these in: Project → Settings → Environment Variables

# ─── Server ──────────────────────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# ─── MongoDB (optional — app uses memory fallback if not set) ─────────────────
# Get a free cluster at https://www.mongodb.com/atlas
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/zkcred

# ─── Google OAuth 2.0 ────────────────────────────────────────────────────────
# 1. Go to https://console.cloud.google.com/apis/credentials
# 2. Create an OAuth 2.0 Client ID  (Application type: Web application)
# 3. Under "Authorized redirect URIs" add ALL of:
#
#    LOCAL DEV (vercel dev):
#      http://localhost:3000/api/auth/google/callback
#
#    VERCEL PRODUCTION:
#      https://zk-cred.vercel.app/api/auth/google/callback
#
# 4. Copy Client ID and Client Secret below.
#    DO NOT set GOOGLE_REDIRECT_URI — it is auto-detected from the request host.

GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
