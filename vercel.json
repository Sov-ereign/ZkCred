{
  "version": 2,
  "builds": [
    { "src": "ui/**", "use": "@vercel/static" },
    { "src": "api/index.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.js" },
    { "src": "/favicon.svg", "dest": "/ui/favicon.svg" },
    { "src": "/(.*\\.\\w+)$", "dest": "/ui/$1" },
    { "src": "/(.*)", "dest": "/ui/index.html" }
  ]
}
